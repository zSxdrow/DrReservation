<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    @using Common.Dto
    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @using Dr.Application.Services.Appoinments.Query.GetAppoinment
    @model List<ResultGetAppoinment>
    @{
        ViewData["Title"] = "لیست نوبت‌ها";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div dir="rtl" style="padding: 1.5rem;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:34px; height:34px; border-radius:50%; background:#eff6ff; display:flex; align-items:center; justify-content:center;">
                    <i class="ti ti-calendar-stats" style="font-size:17px; color:#3b82f6;"></i>
                </div>
                <h5 style="margin:0;">لیست نوبت‌ها</h5>
            </div>
            <a asp-area="" asp-controller="Appoinment" asp-action="AddAppoinment" class="btn btn-primary btn-sm">
                <i class="ti ti-plus"></i> افزودن نوبت
            </a>
        </div>

        @if (Model == null)
        {
            <div class="alert alert-info text-center">
                <i class="ti ti-info-circle" style="font-size:18px;"></i>
                هیچ نوبتی ثبت نشده است.
            </div>
        }
        else
        {
            <div style="background:white; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
                <div class="table-responsive">
                    <table class="table table-hover text-center mb-0" style="font-size:13px;">
                        <thead style="background:#f9fafb;">
                            <tr>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">کد نوبت</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">نام</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">نام خانوادگی</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">کد ملی</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">تلفن</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">بیمه</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">خدمت</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">تاریخ</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">زمان</th>
                                <th style="padding:12px 8px; font-weight:500; color:#6b7280; border-bottom:1px solid #e5e7eb;">ویزیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom:1px solid #f3f4f6;">
                                    <td style="padding:10px 8px;">
                                        <span style="background:#eff6ff; color:#3b82f6; font-size:11px; padding:3px 8px; border-radius:6px;">
                                            @item.AppoinmentCode
                                        </span>
                                    </td>
                                    <td style="padding:10px 8px;">@item.Name</td>
                                    <td style="padding:10px 8px;">@item.lName</td>
                                    <td style="padding:10px 8px; color:#6b7280;">@item.NationalCode</td>
                                    <td style="padding:10px 8px; color:#6b7280;">@item.Phone</td>
                                    <td style="padding:10px 8px;">@item.Insurance</td>
                                    <td style="padding:10px 8px;">@item.Service</td>
                                    <td style="padding:10px 8px; color:#6b7280;">
                                        @item.Date
                                    </td>
                                    <td style="padding:10px 8px; color:#6b7280;">
                                        @item.Time
                                    </td>
                                    <td>
                                        @if(item.IsVisited)
                                        {
                                            <a class="btn btn-sm btn-secondary not-visited-btn" style=" background-color: rgb(131, 131, 131); color:black" onclick="ChangeIsVisited('@item.AppoinmentCode')">
                                               مراجعه نکرد
                                            </a>
                                        }
                                        @if(!item.IsVisited)
                                        {
                                            <a class="btn btn-success" style="color:papayawhip;"  onclick="ChangeIsVisited('@item.AppoinmentCode')">
                                                ویزیت شد
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="padding:10px 16px; background:#f9fafb; border-top:1px solid #e5e7eb; font-size:12px; color:#6b7280;">
                    تعداد کل نوبت‌ها: <strong>@Model.Count()</strong>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
        <script src="~/Sweetalert2/sweetalert2.min.js"></script>

        <script>

            function ChangeIsVisited(appCode) {
                Swal.fire({
                    title: 'ثبت ویزیت',
                    text: 'آیا میخواهید وضعیت بیمار را تغیر دهید؟',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'بله ',
                    cancelButtonText: 'خیر'
                }).then((result) => {

                    if (result.value) {
                      
                        var postData = {
                            'appCode': appCode
                        };
                        $.ajax({
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            type: 'POST',
                            url: '/Admin/Appoinment/IsVisited',
                            data: postData,
                            success: function (data) {

                                if (data.isSuccess == true) {
                                    
                                    Swal.fire(
                                        'موفق!',
                                        data.message,
                                        'success'
                                    ).then(function () {
                                        location.reload();
                                    });

                                } else {

                                    Swal.fire(
                                        'هشدار!',
                                        data.message,
                                        'warning'
                                    );
                                }
                            },

                            error: function (xhr, status, error) {

                                console.log(xhr.status);
                                console.log(xhr.responseText);
                                console.log(error);

                                Swal.fire(
                                    'خطا!',
                                    'ارتباط با سرور برقرار نشد',
                                    'error'
                                );
                            }
                        });
                    }
                });
            }
        </script>
    }
</body>
</html>