    @using Presentation.Controllers
    @{
        ViewData["Title"] = "رزرو نوبت";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    @model Appoinment
    <style>
        .cal-day {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
        }

            .cal-day:hover:not(.disabled):not(.holiday) {
                background: #eff6ff;
                color: #1d4ed8;
            }

            .cal-day.selected {
                background: #3b82f6;
                color: white;
            }

            .cal-day.disabled {
                color: #d1d5db;
                cursor: default;
            }

            .cal-day.holiday {
                color: #ef4444;
                cursor: not-allowed;
            }

            .cal-day.today {
                border: 1px solid #3b82f6;
            }

        .time-card {
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
        }

            .time-card:hover:not(.taken) {
                border-color: #3b82f6;
                background: #eff6ff;
            }

            .time-card.selected {
                border-color: #3b82f6;
                background: #eff6ff;
            }

            .time-card.taken {
                opacity: 0.4;
                cursor: not-allowed;
                background: #f9fafb;
            }

        .step-dot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 500;
        }

            .step-dot.active {
                background: #3b82f6;
                color: white;
            }

            .step-dot.done {
                background: #10b981;
                color: white;
            }

            .step-dot.pending {
                background: #f3f4f6;
                color: #9ca3af;
                border: 1px solid #e5e7eb;
            }
    </style>

    <div dir="rtl" style="max-width:560px; margin:2rem auto; padding:0 1rem;">

        <!-- استپ‌ها -->
        <div style="display:flex; align-items:center; margin-bottom:2rem;">
            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                <div class="step-dot active" id="dot1">1</div>
                <span style="font-size:11px; color:#6b7280;">تاریخ</span>
            </div>
            <div style="flex:1; height:1px; background:#e5e7eb; margin:0 8px; margin-bottom:18px;"></div>
            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                <div class="step-dot pending" id="dot2">2</div>
                <span style="font-size:11px; color:#6b7280;">زمان</span>
            </div>
            <div style="flex:1; height:1px; background:#e5e7eb; margin:0 8px; margin-bottom:18px;"></div>
            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                <div class="step-dot pending" id="dot3">3</div>
                <span style="font-size:11px; color:#6b7280;">اطلاعات</span>
            </div>
            <div style="flex:1; height:1px; background:#e5e7eb; margin:0 8px; margin-bottom:18px;"></div>
            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                <div class="step-dot pending" id="dot4">4</div>
                <span style="font-size:11px; color:#6b7280;">تأیید</span>
            </div>
        </div>

        <!-- مرحله ۱: تقویم -->
        <div id="step1">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                    <button onclick="changeMonth(1)" class="btn btn-sm btn-outline-secondary">< </button>
                    <strong id="monthTitle"></strong>
                    <button onclick="changeMonth(-1)" class="btn btn-sm btn-outline-secondary">></button>
                </div>
                <div style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-bottom:8px; text-align:center;">
                    <div style="font-size:11px; color:#6b7280;">شنبه</div>
                    <div style="font-size:11px; color:#6b7280;">یکشنبه</div>
                    <div style="font-size:11px; color:#6b7280;">دوشنبه</div>
                    <div style="font-size:11px; color:#6b7280;">سه شنبه</div>
                    <div style="font-size:11px; color:#6b7280;">چهار شنبه</div>
                    <div style="font-size:11px; color:#6b7280;">پنجشنبه</div>
                    <div style="font-size:11px; color:#ef4444;">جمعه</div>
                </div>
                <div id="calGrid" style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px;"></div>
                <div id="dateError" class="text-danger mt-2" style="font-size:12px; display:none;"></div>
            </div>
        </div>

        <!-- مرحله ۲: انتخاب زمان -->
        <div id="step2" style="display:none;">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem;">
                <p style="font-size:13px; color:#6b7280; margin:0 0 4px;">تاریخ انتخابی</p>
                <p id="selectedDateLabel" style="font-size:15px; font-weight:500; margin:0 0 1.25rem;"></p>
                <p style="font-size:13px; color:#6b7280; margin:0 0 12px;">زمان مراجعه را انتخاب کنید:</p>
                <div id="timeGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:10px;"></div>
                <div id="timeError" class="text-danger mt-2" style="font-size:12px; display:none;">لطفا یک زمان انتخاب کنید</div>
                <div style="display:flex; gap:10px; margin-top:1.25rem;">
                    <button onclick="goStep(1)" class="btn btn-outline-secondary" style="flex:1;">بازگشت</button>
                    <button onclick="goStep(3)" class="btn btn-primary" style="flex:2;">مرحله بعد</button>
                </div>
            </div>
        </div>

        <!-- مرحله ۳: اطلاعات بیمار -->
        <div id="step3" style="display:none;">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem;">
                <div style="background:#f9fafb; border-radius:8px; padding:10px 14px; margin-bottom:1.25rem; font-size:13px; color:#6b7280;">
                    <span id="summaryLabel"></span>
                </div>
                <div style="display:grid; gap:12px;">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                        <div>
                            <label class="form-label" style="font-size:12px; color:#6b7280;">نام</label>
                            <input type="text" id="fname" class="form-control" placeholder="نام">
                        </div>
                        <div>
                            <label class="form-label" style="font-size:12px; color:#6b7280;">نام خانوادگی</label>
                            <input type="text" id="lname" class="form-control" placeholder="نام خانوادگی">
                        </div>
                    </div>
                    <div>
                        <label class="form-label" style="font-size:12px; color:#6b7280;">کد ملی</label>
                        <input type="text" id="natcode" class="form-control" placeholder="0000000000"
                               maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:12px; color:#6b7280;">شماره تلفن</label>
                        <input type="text" id="phone" class="form-control" placeholder="09000000000"
                               maxlength="11" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                    </div>
                    <div style="border-top:1px solid #f3f4f6; padding-top:1rem; display:grid; gap:12px;">
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                            <div>
                                <label class="form-label" style="font-size:12px; color:#6b7280;">بیمه</label>
                                <select id="InsuranceID" class="form-select" asp-items="@ViewBag.Insurance">
                                    <option value="">انتخاب کنید</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" style="font-size:12px; color:#6b7280;">نوع خدمت</label>
                                <select id="ServiceID" class="form-select" asp-items="@ViewBag.Services">
                                    <option value="">انتخاب کنید</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="infoError" class="text-danger mt-2" style="font-size:12px; display:none;"></div>
                <div style="display:flex; gap:10px; margin-top:1.25rem;">
                    <button onclick="goStep(2)" class="btn btn-outline-secondary" style="flex:1;">بازگشت</button>
                    <button onclick="submitReservation()" class="btn btn-success" style="flex:2;">ثبت نوبت</button>
                </div>
            </div>
        </div>

        <!-- مرحله ۴: تأیید -->
        <div id="step4" style="display:none;">
            <div style="background:white; border:1px solid #d1fae5; border-radius:12px; padding:2rem; text-align:center;">
                <div style="width:52px; height:52px; border-radius:50%; background:#d1fae5; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:24px; color:#10b981;">✓</div>
                <p style="font-size:16px; font-weight:500; margin:0 0 6px;">نوبت شما ثبت شد</p>
                <p id="confirmMsg" style="font-size:13px; color:#6b7280; margin:0 0 1.5rem;"></p>
                <div id="codeBox" style="background:#f9fafb; border-radius:8px; padding:10px 16px; display:inline-block; font-size:13px;"></div>
            <h2 style="margin-left:auto;color:maroon">لطفا از این صفحه اسکرین شات بگیرید</h2>
            </div>
        </div>
    </div>

    @section Scripts {
        <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
        <script src="~/Sweetalert2/sweetalert2.min.js"></script>
        <script>


            const jalaliMonths = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
            const toFa = n => String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);

            const holidays = {
                '1405/4/4': true, '1405/4/11': true, '1405/4/18': true, '1405/4/25': true
            };

            let curYear = @ViewBag.curYear, curMonth = @ViewBag.curMonth, selDate = null, selTime = null;
            let availableTimes = [];
            let validDates = [];

                    $.ajax({
                url: '/Appoinment/GenerateDate',
                success: function(data) {
                    console.log(data);
                }
            });

            function jDaysInMonth(y, m) {
                if (m <= 6) return 31;
                if (m <= 11) return 30;
                return (y % 4 === 3) ? 30 : 29;
            }

            function jDayOfWeek(y, m, d) {
                let jy = y - 979;
                let jm = m - 1;
                let jd = d - 1;
                let jDay = 365 * jy + Math.floor(jy / 4) * 8 - Math.floor(jy / 100) + Math.floor(jy / 400);
                for (let i = 0; i < jm; i++) jDay += [31,28,31,30,31,30,31,31,30,31,30,31][i];
                jDay += jd;
                return (((jDay) % 7) + 7) % 7;
            }

            function loadValidDates() {
                $.ajax({
                    url: '/Appoinment/GetValidDates',
                    success: function (data) {
                        validDates = data;
                        renderCal(); // ← فقط اینجا renderCal صدا زده میشه
                    },
                    error: function () {
                        Swal.fire('خطا', 'خطا در دریافت تاریخ‌های معتبر', 'error');
                    }
                });
            }

            function renderCal() {
                document.getElementById('monthTitle').textContent = toFa(curYear) + ' ' + jalaliMonths[curMonth - 1];
                const grid = document.getElementById('calGrid');
                grid.innerHTML = '';
                const days = jDaysInMonth(curYear, curMonth);
                const firstDow = jDayOfWeek(curYear, curMonth, 1);
                const offset = (firstDow + 6) % 7;
                for (let i = 0; i < offset; i++) grid.appendChild(document.createElement('div'));

                const today = { y: @ViewBag.Year, m: @ViewBag.Month, d: @ViewBag.Day };

                for (let d = 1; d <= days; d++) {
                    const key = curYear + '/' + curMonth + '/' + d;
                    const dow = jDayOfWeek(curYear, curMonth, d);
                    // جمعه = dow===0 در این فرمول — تنظیم کن اگه نیاز داشتی
                    const isHoliday = dow === 0 || holidays[key];
                    const isPast = (curYear < today.y)
                        || (curYear === today.y && curMonth < today.m)
                        || (curYear === today.y && curMonth === today.m && d < today.d);
                    const isToday = curYear === today.y && curMonth === today.m && d === today.d;
                    const isSel = selDate && selDate.y === curYear && selDate.m === curMonth && selDate.d === d;

                    const el = document.createElement('div');
                    el.className = 'cal-day'
                        + (isHoliday ? ' holiday' : '')
                        + (isPast ? ' disabled' : '')
                        + (isToday ? ' today' : '')
                        + (isSel ? ' selected' : '');
                    el.textContent = toFa(d);

                    if (!isPast && !isHoliday) {
                        // ← مقایسه عددی (نه toString) چون backend عدد برمیگردونه
                        const validDate = validDates.find(vd =>
                            vd.year === curYear &&
                            vd.month === curMonth &&
                            vd.day === d
                        );

                        if (validDate) {
                            el.onclick = () => {
                                selDate = { y: curYear, m: curMonth, d, dateId: validDate.id };
                                renderCal();
                                setTimeout(() => goStep(2), 300);
                            };
                        } else {
                            el.classList.add('disabled');
                        }
                    }
                    grid.appendChild(el);
                }
            }

            function changeMonth(dir) {
                curMonth += dir;
                if (curMonth > 12) { curMonth = 1; curYear++; }
                if (curMonth < 1) { curMonth = 12; curYear--; }
                renderCal();
            }

            function loadTimes() {
                $.ajax({
                    url: '/Appoinment/GetAvailableTimes',
                    data: { year: selDate.y, month: selDate.m, day: selDate.d },
                    success: function (data) {
                        availableTimes = data;
                        renderTimes();
                    },
                    error: function () {
                        Swal.fire('خطا', 'خطا در دریافت زمان‌های خالی', 'error');
                    }
                });
            }

            function renderTimes() {
                const grid = document.getElementById('timeGrid');
                grid.innerHTML = '';
                if (availableTimes.length === 0) {
                    grid.innerHTML = '<p style="color:#6b7280; font-size:13px; grid-column:span 2; text-align:center;">نوبتی برای این روز تعریف نشده</p>';
                    return;
                }
                availableTimes.forEach(t => {
                    const el = document.createElement('div');
                    el.className = 'time-card' + (t.isTaken ? ' taken' : '') + (selTime === t.id ? ' selected' : '');
                    el.innerHTML = `<p style="margin:0; font-size:15px; font-weight:500;">${t.label}</p>
                                    <p style="margin:4px 0 0; font-size:11px; color:${t.isTaken ? '#ef4444' : '#10b981'};">
                                        ${t.isTaken ? 'رزرو شده' : 'خالی'}
                                    </p>`;
                    if (!t.isTaken) el.onclick = () => { selTime = t.id; renderTimes(); };
                    grid.appendChild(el);
                });
            }

            function goStep(n) {
                if (n === 2) {
                    document.getElementById('selectedDateLabel').textContent =
                        toFa(selDate.d) + ' ' + jalaliMonths[selDate.m - 1] + ' ' + toFa(selDate.y);
                    document.getElementById('timeError').style.display = 'none';
                    selTime = null; // ← reset زمان قبلی
                    loadTimes();
                }
                if (n === 3) {
                    if (!selTime) {
                        document.getElementById('timeError').style.display = 'block';
                        return;
                    }
                    const t = availableTimes.find(x => x.id === selTime);
                    document.getElementById('summaryLabel').textContent =
                        toFa(selDate.d) + ' ' + jalaliMonths[selDate.m - 1] + ' ' + toFa(selDate.y) + ' — ساعت ' + t.label;
                }
                for (let i = 1; i <= 4; i++) {
                    const el = document.getElementById('step' + i);
                    if (el) el.style.display = i === n ? 'block' : 'none';
                    const dot = document.getElementById('dot' + i);
                    dot.className = 'step-dot ' + (i < n ? 'done' : i === n ? 'active' : 'pending');
                    dot.textContent = i < n ? '✓' : i;
                }
            }

            function submitReservation() {
                const fname = document.getElementById('fname').value.trim();
                const lname = document.getElementById('lname').value.trim();
                const nat = document.getElementById('natcode').value.trim();
                const phone = document.getElementById('phone').value.trim();
                const insuranceID = document.getElementById('InsuranceID').value;
                const serviceID = document.getElementById('ServiceID').value;
                const err = document.getElementById('infoError');

                if (!fname)   { err.textContent = 'نام را وارد کنید'; err.style.display = 'block'; return; }
                if (!lname)   { err.textContent = 'نام خانوادگی را وارد کنید'; err.style.display = 'block'; return; }
                if (!/^\d{10}$/.test(nat))   { err.textContent = 'کد ملی باید ۱۰ رقم باشد'; err.style.display = 'block'; return; }
                if (!/^09\d{9}$/.test(phone)) { err.textContent = 'شماره تلفن باید با ۰۹ شروع شده و ۱۱ رقم باشد'; err.style.display = 'block'; return; }
                if (!insuranceID) { err.textContent = 'نوع بیمه را انتخاب کنید'; err.style.display = 'block'; return; }
                if (!serviceID)   { err.textContent = 'نوع خدمت را انتخاب کنید'; err.style.display = 'block'; return; }
                err.style.display = 'none';

                const t = availableTimes.find(x => x.id === selTime);

                Swal.fire({
                    title: 'ثبت نوبت',
                    text: 'آیا اطلاعات وارد شده صحیح است؟',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'بله ثبت شود',
                    cancelButtonText: 'خیر',
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#ef4444'
                }).then(res => {
                    if (res.value) {  // ← مشکل اصلی اینجا بود
                        $.ajax({
                            url: '/Appoinment/AddAppoinment',
                            type: 'POST',
                            contentType: 'application/x-www-form-urlencoded',
                            data: {
                                Name: fname,
                                lName: lname,
                                NationalCode: nat,
                                Phone: phone,
                                DateID: selDate.dateId,
                                TimeID: selTime,
                                InsuranceID: insuranceID,
                                ServiceID: serviceID
                            },
                            success: function (result) {
                                if (result.isSuccess) {
                                    document.getElementById('confirmMsg').textContent =
                                        fname + ' ' + lname + ' — ' + toFa(selDate.d) + ' ' + jalaliMonths[selDate.m - 1] + ' ساعت ' + t.label;
                                    document.getElementById('codeBox').innerHTML =
                                        'کد نوبت: <strong>' + result.trackingCode + '</strong>';
                                    goStep(4);
                                } else {
                                    Swal.fire('خطا', result.message || 'خطایی رخ داد', 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('خطا', 'ارتباط با سرور برقرار نشد', 'error');
                            }
                        });
                    }
                });
            }

            // ← فقط loadValidDates صدا زده میشه، اون داخلش renderCal رو صدا میزنه
            loadValidDates();
        </script>
    }